          {
            "name": "gdp_yoy_pct",
            "dataType": "double",
            "sourceColumn": "gdp_yoy_pct",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "gdp_qoq_sa_pct",
            "dataType": "double",
            "sourceColumn": "gdp_qoq_sa_pct",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "trm_yoy_pct",
            "dataType": "double",
            "sourceColumn": "trm_yoy_pct",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "revision",
            "dataType": "string",
            "sourceColumn": "revision",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "Quarterly",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties = false]),",
                "    Data = Source{[Schema=\"pp_mart\", Item=\"quarterly_main\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "4c48d9e1-2e27-5210-8e63-5e9a1231a95b",
